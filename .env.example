# ==============================================================================
# Authenticator Toolkit 环境变量配置模板
# 生产配置请勿直接写入此文件；真实凭据应保存在宿主机安全目录（如 ~/.hermes/.secrets/）
# ==============================================================================

# 服务监听端口（默认 5000）
PORT=5000

# HTTP Basic Auth 访问用户名（默认 admin）
TOTP_ACCESS_USER=admin

# HTTP Basic Auth 访问口令（必填；未配置时服务拒绝启动以确保安全）
TOTP_ACCESS_PASSWORD=

# HTTP Basic Auth 访问口令哈希（可选，werkzeug 格式；配置时优先于明文口令）
TOTP_ACCESS_PASSWORD_HASH=

# IP 每日请求次数上限（默认 50）
RATE_LIMIT_DAILY=50

# 限流数据存储路径（默认 /data/usage.db）
RATE_LIMIT_DB=/data/usage.db
